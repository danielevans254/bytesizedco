# Byte Sized Co. environment variables
#
# Copy to .env.local for local dev. Set the same values in Vercel for production
# (Project Settings > Environment Variables), then REDEPLOY.
#
# Two rules that cause most of the pain:
#
#  1. NO QUOTES in Vercel. Vercel's UI stores literally what you paste, so
#     BEEHIIV_API_KEY="abc" there becomes the 5-character string "abc" with the
#     quotes included, and every API call fails. Paste the inner value only.
#     (.env.local is different: dotenv strips surrounding quotes for you.)
#
#  2. NEXT_PUBLIC_* are inlined at BUILD time. Saving one in the Vercel dashboard
#     changes nothing until the next deploy. Everything else is read at runtime.
#
# Every integration is env-gated and skips silently when its vars are absent, so
# you can switch these on one at a time. The exception is the waitlist: with no
# Beehiiv vars in production it has nowhere to store a signup at all.


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED. Without these the live waitlist captures nobody.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical origin. Feeds metadataBase (og:image, twitter:image), sitemap.xml,
# robots.txt, the product-page canonical tags, and the Beehiiv referring_site.
# Set this on preview deployments too, pointed at the preview URL, so previews
# do not emit production URLs into structured data.
NEXT_PUBLIC_SITE_URL=https://bytesizedco.com

# beehiiv.com > Settings > Integrations > API. Create a V2 key.
# Needs read on the publication (for the subscriber counter) and write on
# subscriptions. Roughly 64 characters.
BEEHIIV_API_KEY=

# Same page as the API key. Starts with "pub_", exactly 40 characters.
BEEHIIV_PUBLICATION_ID=


# ─────────────────────────────────────────────────────────────────────────────
# NEEDED BEFORE MARKETING. Without these you are flying blind.
# ─────────────────────────────────────────────────────────────────────────────

# Plausible > site settings. Current form is https://plausible.io/js/pa-XXXXX.js
# Until this is set, track() is a no-op, which means the waitlist_submit
# conversion event records nothing and no campaign can be attributed.
NEXT_PUBLIC_PLAUSIBLE_SRC=

# Only needed for the older data-domain script variant. Usually leave blank.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Full profile URLs. Each footer link renders ONLY when its var is set, so set
# just the handles you have actually registered. No dead links either way.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_X=


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL. Each feature stays completely dormant until its vars are set.
# ─────────────────────────────────────────────────────────────────────────────

# ISO 8601. Switches on the Drop 001 countdown section and its nav link.
# Left blank the section is stripped entirely, rather than counting down to
# 00:00:00:00, which would be fake urgency.
# Example: 2026-11-15T17:00:00Z
NEXT_PUBLIC_DROP_DEADLINE=

# Your own copy of the list, so it survives changing newsletter providers.
# Apply supabase/schema.sql in the Supabase SQL editor FIRST, then set both.
# Both are required together, or store.js stays off.
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS: server-only, never prefixed
# NEXT_PUBLIC_, never read from a client component.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (pre-order confirmations). Beehiiv owns the newsletter and
# the waitlist welcome, so nothing here fires on a plain landing signup.
# Both are required together, or email.js stays off.
RESEND_API_KEY=
EMAIL_FROM=Byte Sized Co. <hello@bytesizedco.com>

# Optional. Sets reply_to on transactional mail.
EMAIL_REPLY_TO=hello@bytesizedco.com

# Optional. Renders in the transactional email footer. CAN-SPAM wants a real
# postal address, so fill this in once the LLC has a registered one.
COMPANY_POSTAL_ADDRESS=


# ─────────────────────────────────────────────────────────────────────────────
# BEEHIIV BEHAVIOUR OVERRIDES. All optional, all have working defaults.
# ─────────────────────────────────────────────────────────────────────────────

# Default true. Set to the string "false" to stop Beehiiv sending its welcome
# email on every signup. Check what that email says before leaving this on: it
# is the first thing anyone ever receives from you.
BEEHIIV_WELCOME_EMAIL=

# Default "off". Accepts "on" or "not_set". If the publication has double opt-in
# enabled and this override does not take, subscribers land as "pending", never
# become "active", and never appear in the site counter.
BEEHIIV_DOUBLE_OPT=

# Default "Founding Member". Written to the Cohort custom field.
BEEHIIV_COHORT=
